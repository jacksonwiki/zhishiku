# 本地 Ollama 模型（qwen3.5:0.8b 作 LLM，nomic-embed-text 作 embedding）
#LLM_MODEL=qwen3.5:0.8b
EMBEDDING_MODEL=nomic-embed-text



LLM_PROVIDER=deepseek
EMBEDDING_PROVIDER=ollama
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 阿里云千问（备用，当前已欠费停用）=====
DASHSCOPE_API_KEY=

# Chroma 向量库持久化目录
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=zhishiku

# 服务端口
APP_HOST=0.0.0.0
APP_PORT=8000

